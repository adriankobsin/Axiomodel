# Your public site URL (used for SEO / canonical links)
NEXT_PUBLIC_SITE_URL=https://your-new-domain.com

# Optional but recommended: free key from https://artificialanalysis.ai (sign up -> API)
# Unlocks Intelligence / Coding / Math index scores plus measured speed & latency.
ARTIFICIAL_ANALYSIS_API_KEY=

# Optional: an OpenRouter key is NOT required to read the public model catalog.
# Set to 1 to force the bundled offline sample data (useful for local design work).
USE_SAMPLE_DATA=

# ── Payments (Stripe) ─────────────────────────────────────────────
# Test keys: https://dashboard.stripe.com/test/apikeys  (start with sk_test_)
STRIPE_SECRET_KEY=
# From Developers -> Webhooks -> your endpoint -> Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Currency for plan prices in lib/plans.ts (gbp, usd, eur...)
NEXT_PUBLIC_CURRENCY=gbp
# Optional: use prices created in the Stripe dashboard instead of lib/plans.ts
# STRIPE_PRICE_PRO_MONTH=price_...
# STRIPE_PRICE_PRO_YEAR=price_...
# STRIPE_PRICE_TEAM_MONTH=price_...
# STRIPE_PRICE_TEAM_YEAR=price_...
# Set to 1 once Stripe Tax is set up in your dashboard
# STRIPE_AUTOMATIC_TAX=

# ── Chat / Playground ─────────────────────────────────────────────
# ONE key from https://openrouter.ai/keys gives access to every provider's models.
# Free models cost nothing. Paid models (used by Pro subscribers) are billed to
# this account's credit, so set a credit limit on the key in OpenRouter.
OPENROUTER_API_KEY=
# Messages per visitor per day using the site key (defaults: 20 free, 300 Pro)
FREE_DAILY_MESSAGES=20
PRO_DAILY_MESSAGES=300
# Optional: secret for /api/status?token=... to also show usage & credit numbers
STATUS_TOKEN=
